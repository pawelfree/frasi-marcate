{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frasi reference example v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "sentence",
    "context",
    "source",
    "annotation",
    "sentence_translations",
    "descriptions"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "schema_version": { "const": "2.0" },
    "sentence": { "type": "string", "minLength": 3, "maxLength": 1000 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preceding", "following", "context_note"],
      "properties": {
        "preceding": { "type": ["string", "null"] },
        "following": { "type": ["string", "null"] },
        "context_note": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "publisher",
        "title",
        "url",
        "accessed_at",
        "published_at",
        "speaker",
        "timestamp",
        "license_note",
        "genre",
        "medium"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "constructed",
            "corpus",
            "press",
            "audiovisual",
            "literature",
            "other"
          ]
        },
        "publisher": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "pattern": "^https?://" },
        "accessed_at": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "published_at": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "speaker": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] },
        "license_note": { "type": "string" },
        "genre": { "type": "string" },
        "medium": { "type": "string" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction",
        "certainty",
        "spans",
        "neutral_variant",
        "pragmatic_function",
        "annotator_id",
        "review_status"
      ],
      "properties": {
        "construction": {
          "enum": [
            "left_dislocation",
            "right_dislocation",
            "cleft",
            "none",
            "ambiguous"
          ]
        },
        "certainty": { "enum": ["high", "medium", "low"] },
        "spans": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/definitions/span" }
        },
        "neutral_variant": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "status"],
              "properties": {
                "text": { "type": "string" },
                "status": { "const": "proposed_paraphrase" }
              }
            }
          ]
        },
        "pragmatic_function": {
          "type": "array",
          "items": { "type": "string" }
        },
        "annotator_id": { "type": "string" },
        "review_status": { "enum": ["draft", "reviewed"] }
      }
    },
    "sentence_translations": {
      "type": "object",
      "required": ["pl"],
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": { "type": "string" }
    },
    "descriptions": {
      "type": "object",
      "required": ["pl", "it"],
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "additionalProperties": { "$ref": "#/definitions/description" }
    }
  },
  "definitions": {
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "information",
        "pragmatic",
        "evidence",
        "neutral",
        "prosody",
        "spans"
      ],
      "properties": {
        "information": { "type": "string" },
        "pragmatic": { "type": "string" },
        "evidence": { "type": "string" },
        "neutral": { "type": "string" },
        "prosody": { "type": ["string", "null"] },
        "spans": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "start",
        "end",
        "syntactic_role",
        "information_role",
        "relation_to"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "syntactic_role": { "type": "string", "minLength": 1 },
        "information_role": { "type": ["string", "null"] },
        "relation_to": { "type": ["string", "null"] }
      }
    }
  }
}
