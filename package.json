{
  "name": "frasi-marcate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs && tsc -p tsconfig.web.json && sass --no-source-map src/web/style.scss dist/web/assets/style.css",
    "build:api": "nest build",
    "prestart": "npm run build:web",
    "start": "nest start",
    "prestart:dev": "npm run build:web",
    "start:dev": "nest start --watch",
    "build": "npm run build:web && npm run build:api",
    "pretest": "npm run build",
    "format": "prettier --write src scripts test *.json *.md",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/serve-static": "^5.0.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
